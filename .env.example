# Copy to .env and change the API key before deploying
API_KEY=dev-secret-change-me
APP_NAME=Healthcare RAG API
ENVIRONMENT=development

# retrieve = cited extractive answer (fast, CI-friendly)
# generate = retrieve + FLAN-T5 answer (needs model download)
GENERATION_MODE=generate

# true = hash embeddings (no Hugging Face download)
# false = sentence-transformers/all-MiniLM-L6-v2
OFFLINE_EMBEDDINGS=false

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
GENERATOR_MODEL=google/flan-t5-small
TOP_K=4
INDEX_DIR=data/index
KNOWLEDGE_DIR=data/knowledge
